import '../../workout/data/workout.drift';

-- "¿Tiene historial?": cualquier fila en una sesión impide el borrado físico (ON DELETE RESTRICT).
exerciseHasHistory:
SELECT EXISTS (SELECT 1 FROM session_exercises WHERE exercise_id = :exercise_id);

-- "Peso anterior": mejor serie de la sesión MÁS RECIENTE de cada ejercicio.
lastBestPerExercise:
WITH ranked AS (
  SELECT se.exercise_id, sr.weight_kg, sr.reps,
         ROW_NUMBER() OVER (
           PARTITION BY se.exercise_id
           ORDER BY ws.started_at DESC, sr.weight_kg DESC, sr.reps DESC
         ) AS rn
  FROM session_exercises se
  JOIN workout_sessions ws ON ws.id = se.session_id AND ws.status = 'completed'
  JOIN set_records sr      ON sr.session_exercise_id = se.id
  WHERE se.exercise_id IN :exercise_ids
)
SELECT exercise_id, weight_kg, reps FROM ranked WHERE rn = 1;

-- Detector de récords: máximo previo a una sesión (excluye la propia y las posteriores).
maxWeightBefore:
SELECT MAX(sr.weight_kg)
FROM set_records sr
JOIN session_exercises se ON se.id = sr.session_exercise_id
JOIN workout_sessions ws  ON ws.id = se.session_id
WHERE se.exercise_id = :exercise_id
  AND ws.status = 'completed'
  AND ws.started_at < (SELECT started_at FROM workout_sessions WHERE id = :session_id);
